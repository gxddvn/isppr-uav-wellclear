QMainWindow {
    background-color: #2b2b2b;
    color: #ddd;
}

QTabWidget::pane {
    border: 1px solid #444;
    background: #333;
}

QPushButton {
    background-color: #444;
    color: white;
    border-radius: 4px;
    padding: 6px;
}

QPushButton:hover {
    background-color: #666;
}

QTextEdit {
    background-color: #1e1e1e;
    color: #eee;
    border: 1px solid #444;
}

QLabel {
    color: white;
}

/* === QMessageBox Global Style === */
QMessageBox {
    background-color: #1E1E1E;
    border: 1px solid #3C3C3C;
    color: #FFFFFF;
}

QMessageBox QLabel {
    color: #FFFFFF;
    font-size: 14px;
}
